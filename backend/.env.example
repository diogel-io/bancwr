# For running the bunker binary directly (cargo run). See ../.env.example and docs/operating.md.
BUNKER_PORT=3000
DATABASE_PATH=./data/bancwr.db

# The key is encrypted at rest (#94). Once: `openssl rand -hex 32 > secrets/bancwr_root_key`, put
# the key in secrets/bunker_nsec, run `cargo run -- import-key` with BUNKER_NSEC_FILE set, then
# delete secrets/bunker_nsec and unset BUNKER_NSEC_FILE. The bunker will not sign while it is set.
BANCWR_ROOT_KEY_FILE=./secrets/bancwr_root_key
# BUNKER_NSEC_FILE=./secrets/bunker_nsec

# Required: openssl rand -hex 32
BANCWR_PROXY_SECRET=

# NIP-46 Configuration
NIP46_ENABLED=true
NIP46_RELAYS=wss://relay.nsecbunker.com,wss://relay.damus.io
