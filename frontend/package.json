{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:backend": "cd ../backend && cargo run",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:stack": "node e2e/stack-cli.ts up",
    "test:e2e:stack:down": "node e2e/stack-cli.ts down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.2",
    "nostr-tools": "2.25.2",
    "nuxt": "^4.5.2",
    "uqr": "0.1.3",
    "vue": "3.5.38"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.74",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/ws": "^8.18.1",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.1",
    "ws": "^8.21.0"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "pnpm": {
    "overrides": {
      "vue": "3.5.38"
    }
  }
}
