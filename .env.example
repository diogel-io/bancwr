# Bunker Configuration. The bunker's own key: it signs for others, so it can never sign in or be
# an administrator. The first administrator is BANCWR_ADMIN_PUBKEY, below.
BUNKER_NSEC=nsec1...

# The first administrator: your own npub (or hex), never the bunker's. While no administrator is
# registered, the bunker registers this key as one at startup; once any administrator exists it
# does nothing. See "The first administrator" in README.md.
BANCWR_ADMIN_PUBKEY=npub1...

# Signs who is calling between the frontend and the bunker (both read it; see compose.yaml).
# Required. Generate one with: openssl rand -hex 32
BANCWR_PROXY_SECRET=

# Seals the frontend's session cookie. Required. Generate one with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# The https origin people open Bancwr on, with no path or trailing slash. Required. Sign-in needs
# HTTPS; http:// is accepted only for localhost. See "HTTPS" in README.md.
NUXT_SITE_ORIGIN=https://bancwr.example

# Optional. The relays the profile page reads and publishes members' profiles through, besides each
# member's own NIP-65 relays, comma-separated; and the Blossom server profile images are uploaded to
# when a member has none of their own. Empty uses public defaults (damus, nos.lol, primal; and
# blossom.primal.net). See "Profile" in frontend/README.md.
NUXT_PUBLIC_PROFILE_RELAYS=
# Indexer relays, which collect profiles and relay lists from across the network: members whose
# profile is on none of the relays above are found there. Empty uses purplepag.es,
# profiles.nostr1.com and relay.nos.social.
NUXT_PUBLIC_INDEXER_RELAYS=
NUXT_PUBLIC_BLOSSOM_SERVER=

# NIP-46 Configuration. Turning it on connects no app by itself: an administrator issues a
# single-use connection token for each app, which may then sign only the kinds it was granted.
# See "Connecting an app" in backend/README.md. compose.yaml turns it on when this is unset; set
# it to false to turn NIP-46 off.
NIP46_ENABLED=true
# The bunker's relays are normally chosen by an administrator on the Config page (Bunker relays),
# stored in the bunker's database and applied without a restart. NIP46_RELAYS is an override: when
# set and non-empty, it always decides, comma-separated, and the Config page shows it read-only.
# Leave it unset to manage the relays in the console. See "Bunker relays" in backend/README.md.
# NIP46_RELAYS=wss://relay.nsec.app,wss://relay.damus.io

# Only without compose. compose.yaml sets the bunker's port (3000) and database path
# (/data/bancwr.db, the ./data directory) itself, and reads the key from BUNKER_NSEC, so these do
# nothing under compose. They are for running the bunker binary directly (cargo run).
# BUNKER_PORT=3000
# DATABASE_PATH=./data/bancwr.db
# BUNKER_NSEC_FILE=/run/secrets/bunker_nsec
